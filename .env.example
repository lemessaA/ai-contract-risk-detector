# M-Pesa Configuration
# Copy this file to .env.local and update with your actual credentials

# M-Pesa API Configuration
NEXT_PUBLIC_MPESA_BASE_URL=https://sandbox.safaricom.co.ke/mpesa/
NEXT_PUBLIC_MPESA_CONSUMER_KEY=your_consumer_key_here
NEXT_PUBLIC_MPESA_CONSUMER_SECRET=your_consumer_secret_here
NEXT_PUBLIC_MPESA_PASSKEY=your_passkey_here
NEXT_PUBLIC_MPESA_SHORTCODE=174379

# Payment Settings
NEXT_PUBLIC_MINIMUM_PAYMENT_AMOUNT=10
NEXT_PUBLIC_CURRENCY=KES

# Callback URLs (will be set automatically)
NEXT_PUBLIC_MPESA_CALLBACK_URL=http://localhost:3000/api/payments/mpesa/callback

# Development/Production
NODE_ENV=development
